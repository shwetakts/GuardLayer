# GuardLayer — Environment Configuration
# Copy this file to .env and fill in the values you need.
# All variables have safe defaults; only set what you want to override.

# ─── Policy & Database ──────────────────────────────────────────────────────
# GUARDLAYER_POLICY_PATH=policy/policy.yaml
# GUARDLAYER_DB_PATH=data/audit.db
# GUARDLAYER_DATABASE_URL=sqlite:///data/audit.db

# ─── Logging ────────────────────────────────────────────────────────────────
# GUARDLAYER_LOG_LEVEL=INFO

# ─── Provider: Ollama (local, free) ─────────────────────────────────────────
# GUARDLAYER_OLLAMA_BASE_URL=http://localhost:11434
# GUARDLAYER_OLLAMA_MODEL=llama3.2:3b
# GUARDLAYER_PROVIDER_TIMEOUT=60

# ─── Provider: OpenAI (requires API key) ────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── Provider: Anthropic (requires API key) ─────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─── Optional: Hugging Face toxicity model (local, CPU) ─────────────────────
# Requires: pip install transformers torch
# USE_HF_TOXICITY=False
# GUARDLAYER_TOXICITY_MODEL_NAME=Hate-speech-CNERG/dehatebert-mono-english

# ─── Optional: Hugging Face NER for PII (local, CPU) ────────────────────────
# Requires: pip install transformers torch
# USE_HF_PII_NER=False
# GUARDLAYER_PII_NER_MODEL_NAME=dslim/distilbert-NER

# ─── Optional: Sentence-Transformers for semantic topic matching ────────────
# Installed by default via requirements.txt; model loaded on first use.
# GUARDLAYER_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
